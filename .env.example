# DotCor Environment Configuration
# Copy this file to .env and customize for your setup

# ============================================
# Debug & Logging
# ============================================

# Enable debug logging (shows internal operations, lock acquired/released, etc.)
# Set to any non-empty value to enable
# DOTCOR_DEBUG=1

# ============================================
# Git Configuration
# ============================================

# Default git user name for commits
# GIT_AUTHOR_NAME=Your Name
# GIT_COMMITTER_NAME=Your Name

# Default git user email for commits
# GIT_AUTHOR_EMAIL=your.email@example.com
# GIT_COMMITTER_EMAIL=your.email@example.com

# ============================================
# Common DotCor Paths
# ============================================

# Override default dotcor directory (default: ~/.dotcor)
# DOTCOR_HOME=/path/to/custom/dotcor

# ============================================
# Editor Configuration
# ============================================

# Default editor for viewing diffs and editing files
# EDITOR=vim
# or
# EDITOR=code

# ============================================
# SSH & Git
# ============================================

# SSH key for git operations (if not using default)
# SSH_KEY_PATH=~/.ssh/id_ed25519

# ============================================
# Example Production Environment
# ============================================
# For production/dotfiles repo:
# DOTCOR_DEBUG=0
# GIT_AUTHOR_NAME="Production User"
# GIT_AUTHOR_EMAIL="prod@example.com"

# ============================================
# Example Development Environment
# ============================================
# For development/debugging:
# DOTCOR_DEBUG=1
# GIT_AUTHOR_NAME="Dev User"
# GIT_AUTHOR_EMAIL="dev@example.com"
